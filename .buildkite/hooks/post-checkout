#!/usr/bin/env sh
# .buildkite/hooks/post-checkout
set -eu

echo "--- Pulling Git LFS objects"

# If git-lfs isn't installed on the agent, fail fast with a clear message.
if ! command -v git >/dev/null 2>&1; then
  echo "git not found on agent" >&2
  exit 1
fi
if ! git lfs --version >/dev/null 2>&1; then
  echo "git-lfs not found on agent (install it, or remove this hook)" >&2
  exit 1
fi

# Install LFS filters in the local repo and pull objects for the current commit.
git lfs install --local
git lfs pull

# Also pull LFS objects in submodules (if any).
git submodule foreach --recursive 'git lfs install --local && git lfs pull || exit 1'
